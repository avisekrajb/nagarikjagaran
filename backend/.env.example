# ==========================================================
#  Nagarik API — .env.example
#  यो फाइल नक्कल बनाएर `.env` नाम गर्नुहोस् र आफ्नै मान भर्नुहोस्।
#  .env कहिल्यै अर्कोसँग सेयर नगर्नुहोस्।
# ==========================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=nagarikjagarannews
DB_PORT=3306

# ---------- Server ----------
PORT=5000
# नयाँ random secret खोज्नुहोस्:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ---------- इमेल (सुरक्षा सूचना पठाउन) ----------
# ALERT_EMAIL यहाँ छैन — recipient हार्डकोड छ:
#    backend/src/v2/controllers/alert.js
# गुगल Gmail बाट App Password बनाएर EMAIL_PASS मा राख्नुहोस्।
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
ALERT_ENABLED=true

# ---------- साधारण एडमिन (केवल जानकारीका लागी) ----------
# वास्तविक खाता यहाँबाट होइन, यी backend/src/controllers/password/ भित्र छन्।
ADMIN_NAME=Administrator
ADMIN_EMAIL=a@gmail.com
ADMIN_PASSWORD=123456

# ---------- सार्वजनिक ठेगाना ----------
# इमेलको लिंक यसैमा बन्छ
SITE_URL=http://localhost:3001

# ---------- लग सीमा ----------
MAX_LOG_ROWS=5000
